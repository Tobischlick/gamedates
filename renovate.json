{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":timezone(Europe/Berlin)"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": false,
      "labels": [
        "dependencies"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "groupName": "Spring Boot",
      "matchPackageNames": [
        "/^org.springframework.boot:/"
      ]
    },
    {
      "groupName": "Lombok",
      "matchPackageNames": [
        "org.projectlombok:lombok"
      ],
      "extends": [
        "schedule:monthly"
      ]
    },
    {
      "groupName": "Google APIs",
      "matchPackageNames": [
        "/google-api/"
      ]
    }
  ]
}
